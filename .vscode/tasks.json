{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "Playdate: Build C for simulator",
            "command": "build",
            "targets": [
                "ALL_BUILD"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake Device",
            "type": "shell",
            "windows": {
                "command": "cmd.exe",
                "options": {
                    "cwd": "${workspaceFolder}\\build\\build-device",
                    "env": {
                        "__makefileName": "\"NMake Makefiles\"",
                        "__shellPath": "\"${env:VISUAL_STUDIO_TOOLS}\\vcvars64.bat\""
                    }
                },
                "args": [
                    "/c",
                    "\"%__shellPath%",
                    "^'&'",
                    "cmake",
                    "-G",
                    "%__makefileName%",
                    "..\\..",
                    "--toolchain=${env:PLAYDATE_SDK_PATH}/C_API/buildsupport/arm.cmake\""
                ]
            },
            "osx": {
                "command": "zsh",
                "options": {
                    "cwd": "${workspaceFolder}/build/build-device",
                    "env": {
                        "__makefileName": "Unix Makefiles"
                    }
                },
                "args": [
                    "-c",
                    "cmake -G \"${__makefileName}\" ../.. --toolchain=${env:PLAYDATE_SDK_PATH}/C_API/buildsupport/arm.cmake"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "Playdate: Build C for device",
            "type": "shell",
            "windows": {
                "command": "cmd.exe",
                "options": {
                    "cwd": "${workspaceFolder}\\build\\build-device",
                    "env": {
                        "__shellPath": "\"${env:VISUAL_STUDIO_TOOLS}\\vcvars64.bat\""
                    }
                },
                "args": [
                    "/c",
                    "\"%__shellPath%",
                    "^'&'",
                    "nmake.exe\""
                ],
                "group": "build"
            },
            "osx": {
                "command": "cmake",
                "args": [
                    "--build",
                    "${workspaceFolder}/build/build-device"
                ],
                "group": "build"
            },
            "problemMatcher": []
        },
        {
            "label": "Playdate: Build Lua",
            "type": "pdc",
            "problemMatcher": [
                "$pdc-lua",
                "$pdc-external"
            ],
            "presentation": {
                "revealProblems": "onProblem",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "Playdate: Run",
            "type": "playdate-simulator",
            "problemMatcher": [
                "$pdc-external"
            ],
            "kill": true,
            "presentation": {
                "revealProblems": "onProblem",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "Playdate: Build Lua and Run",
            "dependsOn": [
                "Playdate: Build Lua",
                "Playdate: Run"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Playdate: Build C (Sim + Device) in parallel",
            "dependsOn": [
                "Playdate: Build C for device",
                "Playdate: Build C for simulator"
            ],
            "presentation": {
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Playdate: Build C (Sim + Device) and Run",
            "dependsOn": [
                "Playdate: Build C (Sim + Device) in parallel",
                "Playdate: Run"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}