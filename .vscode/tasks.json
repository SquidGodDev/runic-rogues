{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Playdate: Kill Simulator",
            "type": "shell",
            "windows": {
                "command": "$p = Get-Process PlaydateSimulator -ErrorAction SilentlyContinue; if ($p) { Stop-Process -Id $p.Id -Force; Write-Host 'Playdate Simulator stopped.' } else { Write-Host 'Playdate Simulator not running.' }"
            },
            "osx": {
                "command": "pkill -f 'Playdate Simulator' || true"
            },
            "linux": {
                "command": "pkill -f PlaydateSimulator || true"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "Playdate: Build C for simulator",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "sim"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Playdate: Build C for device",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "device"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Playdate: Build Lua",
            "type": "pdc",
            "problemMatcher": [
                "$pdc-lua",
                "$pdc-external"
            ],
            "presentation": {
                "revealProblems": "onProblem",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "Playdate: Run",
            "type": "playdate-simulator",
            "problemMatcher": [
                "$pdc-external"
            ],
            "presentation": {
                "revealProblems": "onProblem",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "Playdate: Build Lua and Run",
            "dependsOn": [
                "Playdate: Kill Simulator",
                "Playdate: Build Lua",
                "Playdate: Run"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Playdate: Build C (Sim + Device) in parallel",
            "dependsOn": [
                "Playdate: Build C for device",
                "Playdate: Build C for simulator"
            ],
            "presentation": {
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Playdate: Build C (Sim + Device) and Run",
            "dependsOn": [
                "Playdate: Kill Simulator",
                "Playdate: Build C (Sim + Device) in parallel",
                "Playdate: Run"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}