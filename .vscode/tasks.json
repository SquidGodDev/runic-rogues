{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Playdate: Build C for simulator",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "sim"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Playdate: Build C for device",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "device"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Playdate: Build Lua",
            "type": "pdc",
            "problemMatcher": [
                "$pdc-lua",
                "$pdc-external"
            ],
            "presentation": {
                "revealProblems": "onProblem",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "Playdate: Run",
            "type": "playdate-simulator",
            "problemMatcher": [
                "$pdc-external"
            ],
            "kill": true,
            "presentation": {
                "revealProblems": "onProblem",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "Playdate: Build Lua and Run",
            "dependsOn": [
                "Playdate: Build Lua",
                "Playdate: Run"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Playdate: Build C (Sim + Device) in parallel",
            "dependsOn": [
                "Playdate: Build C for device",
                "Playdate: Build C for simulator"
            ],
            "presentation": {
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Playdate: Build C (Sim + Device) and Run",
            "dependsOn": [
                "Playdate: Build C (Sim + Device) in parallel",
                "Playdate: Run"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}