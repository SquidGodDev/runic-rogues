// Specifies what the debugger launch task should be
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Lua Debug",
            "type": "playdate",
            "request": "launch"
        },
        {
            "name": "C Debug",
            "type": "cppdbg",
            "request": "launch",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "windows": {
                "program": "${env:PLAYDATE_SDK_PATH}\\bin\\PlaydateSimulator.exe",
                "MIMode": "gdb",
                "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe"
            },
            "osx": {
                "program": "${env:PLAYDATE_SDK_PATH}/bin/Playdate Simulator.app/Contents/MacOS/Playdate Simulator",
                "MIMode": "lldb"
            },
            "preLaunchTask": "Debug Prelaunch Tasks"
        }
    ],
    "compounds": [
        {
            "name": "Lua + C Debug",
            "configurations": ["Lua Debug", "C Debug"],
            "stopAll": true
        }
    ]
}